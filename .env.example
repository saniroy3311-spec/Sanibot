# ============================================================
# SANIBOT - SMART 50/50 RUNNER PROFILE (4 lots)
# ============================================================
SYMBOL=BTC/USD:USD
PRODUCT_ID=27

# Sizing
POSITION_BTC_SIZE=0.004
ALERT_QTY=4
DEFAULT_LOTS=4
MAX_POSITION_LOTS=4
LOT_SIZE_BTC=0.001
LEVERAGE=200
STATIC_TOTAL_LOTS=4
TRANCHE_1_LOTS=2
TRANCHE_2_LOTS=2

# Strategy
ENTRY_STRATEGY=trend_breakout
CANDLE_TIMEFRAME=30m
BINANCE_SIGNAL_FEED=true
BINANCE_SYMBOL=BTC/USDT

# 1H direction filter
OPT_HTF_TREND_ENABLED=true
OPT_HTF_TIMEFRAME=1h
OPT_HTF_EMA_LEN=8

# Entry quality / anti-chop
ATR_MIN=125.0
OPT_ATR_MIN_FILTER=125.0
ADX_TREND_TH=13
ADX_REQUIRE_RISING=true
EMA_FAST_LEN=9
EMA_TREND_LEN=15
EMA_SEPARATION_ATR_MULT=0.08
BREAKOUT_BOX_BARS=3
BREAKOUT_BUFFER_PTS=5.0
FILTER_BODY_MULT=0.22
FILTER_BODY_TOLERANCE=0.0
FILTER_VOL_ENABLED=true
FILTER_VOL_MULT=0.80
STRUCTURE_FILTER_ENABLED=true
STRUCTURE_LOOKBACK_BARS=4
EXTENSION_MAX_MULT=2.2
DEAD_ZONE_FILTER_ENABLED=false
DEAD_ZONE_START_HOUR_IST=2
DEAD_ZONE_END_HOUR_IST=7

# Risk
MAX_SL_MULT=1.0
MAX_SL_POINTS=180.0
BRACKET_SL_BUFFER=8.0
TB_SL_ATR_MULT=0.8
TB_TP_RR_MULT=2.0
BE_MULT=0.60
BAR_CLOSE_SL_EVAL=true
TP_HARD_EXIT=false
ALLOW_REVERSAL=false
TIME_EXIT_MINUTES=0

# 50/50 partial + runner
PARTIAL_TP_ENABLED=true
PARTIAL_TP_PTS=350.0
PARTIAL_TP_RATIO=0.50
PRE_PARTIAL_TRAIL_ENABLED=false
RUNNER_BE_LOCK_PTS=50.0
RUNNER_WIDE_TRIGGER_PTS=600.0
RUNNER_MIN_CUSHION_PTS=300.0
RUNNER_ATR_MULT=1.25
PARTIAL_VERIFY_RETRIES=4

# Exit confirmation / feeds
SL_CONFIRM_TICKS=5
SL_CONFIRM_MS=1500
TRAIL_SL_CONFIRM_TICKS=4
TRAIL_LOOP_SEC=2.0
SL_FIRE_VIA_BRACKET=true
TRAIL_EXIT_FROM_DELTA_WS=false
TRAIL_FIRE_SL_ON_CANDLE_EXTREME=false
DELTA_TICK_PRICE_FIELD=last
PINE_MINTICK=0.5
PINE_TICK_TRUNCATE=false

# Cooldown: short after wins, one full 30m bar after losses
SIGNAL_COOLDOWN_SEC=0
WIN_COOLDOWN_SEC=180
LOSS_COOLDOWN_BARS=1

# Execution
PAPER_TRADING=false
DRY_RUN=false
TRADING_MODE=LIVE
DELTA_API_KEY=YOUR_DELTA_API_KEY
DELTA_API_SECRET=YOUR_DELTA_API_SECRET
DELTA_TESTNET=false
DELTA_BASE_URL=https://api.india.delta.exchange

# Notifications
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# Fees / slippage
COMMISSION_PCT=0.0005
GST_PCT=0.18
MAKER_FEE_RATE=0.000236
TAKER_FEE_RATE=0.000590
SLIPPAGE_POINTS=8.0
MAX_EXIT_SLIPPAGE_ATR_PCT=25.0
